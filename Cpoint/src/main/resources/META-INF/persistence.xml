<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="cpointPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entities are listed here as each one is migrated to JPA -->
        <class>com.mycompany.cpoint.model.Task</class>
        <class>com.mycompany.cpoint.model.Project</class>
        <class>com.mycompany.cpoint.model.User</class>
        <class>com.mycompany.cpoint.model.Team</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/cpoint"/>
            <property name="jakarta.persistence.jdbc.user" value="cpoint_app"/>
            <!-- The password is not stored here: JPAUtil reads it from database.properties -->

            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
